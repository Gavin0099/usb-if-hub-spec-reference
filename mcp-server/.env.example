# Server
MCP_PORT=8787

# Comma-separated API keys accepted by the auth middleware. Required — the
# server fails closed (503) if this is unset. Never commit real keys; this
# file is a template only (mcp-server/.env is gitignored).
MCP_API_KEYS=changeme-generate-a-real-random-key

# Optional: override the python executable used to run
# scripts/probe_table_fingerprint.py for drift checks.
MCP_PYTHON_BIN=python

# Optional: minimum interval (ms) between fingerprint drift re-checks.
MCP_FINGERPRINT_CHECK_INTERVAL_MS=60000
